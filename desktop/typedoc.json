{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./src/"
  ],
  "entryPointStrategy": "expand",
  "out": "../docs-dev",
  "name": "Glyph Desktop API",
  "includeVersion": true,
  "readme": "../README.md",
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "node_modules"
  ],
  "cleanOutputDir": true,
  "githubPages": false,
  "hideGenerator": true
}